(version 1)

# Plated footprint holes, not routing vias. Board fallback remains 0.25 mm.
(rule "PTH hole to foreign copper"
  (condition "(A.Type == 'Pad' && A.Pad_Type == 'Through-hole') || (B.Type == 'Pad' && B.Pad_Type == 'Through-hole')")
  (constraint hole_clearance (min 0.30mm)))

(rule "PTH to other drilled hole"
  (condition "(A.Type == 'Pad' && A.Pad_Type == 'Through-hole') || (B.Type == 'Pad' && B.Pad_Type == 'Through-hole')")
  (constraint hole_to_hole (min 0.45mm)))


# Native filled art has no outline stroke; retain the stroke check everywhere else.
(rule "Silkscreen graphic stroke minimum"
 (condition "A.Type == 'Graphic' && (A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen') && !(A.Line_Width == 0mm && A.memberOfGroup('Ephemeris 1 — Celestial Atlas'))")
 (constraint assertion "A.Line_Width >= 0.15mm"))
